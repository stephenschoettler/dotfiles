[
    {
        "output": "eDP-2",
        "layer": "top",
        "position": "top",
        "margin-top": 5,
        "margin-left": 2,
        "margin-right": 2,
        "height": 20,
        "modules-left": ["hyprland/workspaces#laptop", "hyprland/window"],
        "modules-center": ["clock"],
        "modules-right": ["idle_inhibitor", "backlight", "pulseaudio", "battery", "tray"],
        "hyprland/workspaces#laptop": {
            "active-only": false,
            "all-outputs": false,
            "format": "{icon}",
            "on-click": "activate",
            "format-window-separator": "\n",
              "window-rewrite-default": "",
              "window-rewrite": {
            },
            "format-icons": {
                "1": "一",
                "2": "二",
                "3": "三",
                "4": "四",
                "5": "五",
                "6": "六",
                "7": "七",
                "8": "八",
                "9": "九",
                "10": "十",
                "default": "",
                "urgent": "",
                "focused": ""
            }
        },
        "hyprland/window": {
            "format": "{}",
            "max-length": 30,
            "rewrite": {
                "(.*) - Mozilla Firefox": " $1",
                "(.*) - Visual Studio Code": " $1",
                "(.*)Discord(.*)": " $1",
                "(.*) - Doom Emacs": " $1",
                "(.*)Emacs(.*)": " $1",
                "(.*) - Brave": " $1",
                "(.*)Brave(.*)": " $1"
            },
            "separate-outputs": true
        },
        "pulseaudio": {
            "justify": "center",
            "format": "{volume}% {icon}",
            "max-volume": 150,
            "format-bluetooth": "{volume}% {icon}",
            "format-bluetooth-muted": "  {icon}",
            "format-icons": {
                "headphone": "",
                "hands-free": "󰋋",
                "headset": "󰋋",
                "phone": "",
                "portable": "",
                "car": "",
                "default": ["", "", ""]
            },
            "on-click": "pavucontrol",
            "on-click-right": "bash ~/.config/waybar/scripts/cycle_audio_sink.sh",
            "on-scroll-up": "pamixer --allow-boost --set-limit 150 -i 5",
            "on-scroll-down": "pamixer --allow-boost --set-limit 150 -d 5"
        },

        "cpu": {
            "justify": "center",
            "format": "{usage}% "
        },
        "memory": {
            "justify": "center",
            "format": "{}% "
        },
        "temperature": {
            "justify": "center",
            "thermal-zone": 2,
            "format": "{temperatureC}°C {icon}",
            "format-icons": ["", "", ""]
        },
        "backlight": {
            "justify": "center",
            "device": "nvidia_wmi_ec_backlight",
            "format": "{percent}% {icon}",
            "format-icons": ["", "", "", "", "", "", "", "", ""],
            "tooltip-format": "Brightness",
            "scroll-step": 5

        },
        "battery": {
            "justify": "center",
            "states": {
                "good": 95,
                "warning": 30,
                "critical": 15
            },
            "format": "{capacity}% {icon}",
            "format-charging": "{capacity}% 󰂄",
            "format-plugged": "{capacity}% ",
            "format-full": "",
            "format-alt": "{time} {icon}",
            "format-icons": ["", "", "", "", "", "", "", "", "", "", ""]
        },
        "clock": {
            "justify": "center",
            "format": " {:%I:%M %p   %a, %b %d}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "calendar": {
                "mode": "month",
                "format": {
                    "today": "<span background='#bd93f9' color='#282a36'><b>{}</b></span>"
                }
            }
        },
        "tray": {
            "icon-size": 12,
            "spacing": 10
        },
        "custom/power": {
            "format": "⏻ ",
            "on-click": "bash ~/.config/waybar/scripts/power-menu.sh"
        },
        "custom/notification": {
            "format": " ",
            "on-click": "swaync-client -t -sw",
            "tooltip": false
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            }
        }
    },
