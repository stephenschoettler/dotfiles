#!/usr/bin/env python3
"""Switch explicit Hyprland desktop themes from this dotfiles repo.

The repo stays the source of truth: theme manifests live under themes/<name>/theme.json
and this command renders the active fragments consumed by Hyprland, hyprpaper,
hyprlock, Waybar, SwayNC, Wofi, and Kitty.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
from pathlib import Path
from typing import Any

REPO = Path(__file__).resolve().parents[1]
THEMES_DIR = REPO / "themes"
CURRENT_FILE = THEMES_DIR / "current"
GENERATED_HEADER = "# Generated by bin/hypr-theme. Edit themes/<name>/theme.json, not this file."
CSS_HEADER = "/* Generated by bin/hypr-theme. Edit themes/<name>/theme.json, not this file. */"
KNOWN_MONITORS = ["eDP-2", "HDMI-A-1", "DP-1"]


def die(message: str, code: int = 1) -> None:
    print(f"hypr-theme: {message}", file=sys.stderr)
    raise SystemExit(code)


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def run(command: list[str], *, check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(content, encoding="utf-8")
    tmp.replace(path)


def load_theme(name: str) -> dict[str, Any]:
    theme_path = THEMES_DIR / name / "theme.json"
    if not theme_path.exists():
        available = ", ".join(list_themes()) or "none"
        die(f"unknown theme '{name}'. Available themes: {available}")
    try:
        data = json.loads(theme_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        die(f"invalid JSON in {theme_path}: {exc}")
    data.setdefault("id", name)
    data["_path"] = theme_path
    validate_theme(data)
    return data


def validate_theme(theme: dict[str, Any]) -> None:
    required = ["id", "label", "wallpaper", "colors"]
    for key in required:
        if key not in theme:
            die(f"theme {theme.get('id', '<unknown>')} missing required key '{key}'")
    required_colors = [
        "background",
        "foreground",
        "comment",
        "current_line",
        "selection",
        "cyan",
        "green",
        "orange",
        "pink",
        "purple",
        "red",
        "yellow",
        "panel",
        "surface",
        "surface_alt",
        "surface_hover",
        "selection_border",
        "border",
        "muted",
        "hypr_active_border",
        "hypr_inactive_border",
        "lock_background_rgba",
        "lock_foreground_rgba",
        "lock_accent_rgb",
        "lock_accent_rgba",
        "lock_check_rgb",
        "lock_fail_rgb",
        "waybar_panel",
        "waybar_gradient_start",
        "waybar_gradient_end",
        "waybar_active_foreground",
        "waybar_urgent_background",
        "swaync_panel",
        "swaync_critical_background",
        "wofi_window_background",
    ]
    colors = theme["colors"]
    for key in required_colors:
        if key not in colors:
            die(f"theme {theme['id']} missing colors.{key}")
    wallpaper = (REPO / theme["wallpaper"]).resolve()
    if not wallpaper.exists():
        die(f"theme {theme['id']} wallpaper does not exist: {wallpaper}")


def list_themes() -> list[str]:
    if not THEMES_DIR.exists():
        return []
    return sorted(path.name for path in THEMES_DIR.iterdir() if (path / "theme.json").exists())


def current_theme() -> str | None:
    if CURRENT_FILE.exists():
        value = CURRENT_FILE.read_text(encoding="utf-8").strip()
        return value or None
    return None


def color_hex_no_hash(value: str) -> str:
    return value[1:] if value.startswith("#") else value


def rgb_from_hex(value: str) -> str:
    raw = color_hex_no_hash(value)
    if len(raw) != 6:
        die(f"expected #rrggbb color, got {value}")
    try:
        red = int(raw[0:2], 16)
        green = int(raw[2:4], 16)
        blue = int(raw[4:6], 16)
    except ValueError:
        die(f"expected #rrggbb color, got {value}")
    return f"rgb({red}, {green}, {blue})"


def rgba_from_hex(value: str, alpha: str = "1.0") -> str:
    raw = color_hex_no_hash(value)
    if len(raw) != 6:
        die(f"expected #rrggbb color, got {value}")
    try:
        red = int(raw[0:2], 16)
        green = int(raw[2:4], 16)
        blue = int(raw[4:6], 16)
    except ValueError:
        die(f"expected #rrggbb color, got {value}")
    return f"rgba({red}, {green}, {blue}, {alpha})"


def wallpaper_path(theme: dict[str, Any]) -> Path:
    return (REPO / theme["wallpaper"]).resolve()


def wallpaper_config_path(theme: dict[str, Any]) -> str:
    """Return a stable path for generated config files.

    Worktree previews should not bake `.worktrees/<task>` paths into tracked
    desktop config. Stephen's active checkout convention is ~/dev/dotfiles, so
    prefer that path when the asset exists there; otherwise fall back to this
    repo's absolute path for new assets that only exist on the branch.
    """
    rel = Path(theme["wallpaper"])
    primary = Path.home() / "dev" / "dotfiles" / rel
    if primary.exists():
        return f"~/dev/dotfiles/{rel.as_posix()}"
    return str(wallpaper_path(theme))


def monitor_names(theme: dict[str, Any]) -> list[str]:
    configured = theme.get("monitors") or KNOWN_MONITORS
    return [str(mon) for mon in configured]


def render_hypr_theme(theme: dict[str, Any]) -> str:
    colors = theme["colors"]
    rounding = theme.get("hypr", {}).get("rounding", 10)
    return f"""{GENERATED_HEADER}
# Active theme: {theme['id']} ({theme['label']})

general {{
    col.active_border = {colors['hypr_active_border']}
    col.inactive_border = {colors['hypr_inactive_border']}
}}

decoration {{
    rounding = {rounding}
}}
"""


def render_hyprpaper(theme: dict[str, Any]) -> str:
    wallpaper = wallpaper_config_path(theme)
    fit = theme.get("wallpaper_fit", "cover")
    blocks = [f"""wallpaper {{
    monitor =
    path = {wallpaper}
    fit_mode = {fit}
}}
"""]
    for monitor in monitor_names(theme):
        blocks.append(f"""wallpaper {{
    monitor = {monitor}
    path = {wallpaper}
    fit_mode = {fit}
}}
""")
    return f"""{GENERATED_HEADER}
# Active theme: {theme['id']} ({theme['label']})
splash = false
ipc = true

{''.join(blocks)}"""


def render_hyprlock(theme: dict[str, Any]) -> str:
    colors = theme["colors"]
    template_path = REPO / "hypr" / "hyprlock.base.conf"
    template = template_path.read_text(encoding="utf-8")
    values = {
        "@THEME_ID@": theme["id"],
        "@THEME_LABEL@": theme["label"],
        "@WALLPAPER@": wallpaper_config_path(theme),
        "@LOCK_BACKGROUND_RGBA@": colors["lock_background_rgba"],
        "@LOCK_FOREGROUND_RGBA@": colors["lock_foreground_rgba"],
        "@LOCK_ACCENT_RGB@": colors["lock_accent_rgb"],
        "@LOCK_ACCENT_RGBA@": colors["lock_accent_rgba"],
        "@LOCK_INNER_RGB@": rgb_from_hex(colors["background"]),
        "@LOCK_FONT_RGB@": rgb_from_hex(colors["foreground"]),
        "@LOCK_CHECK_RGB@": colors["lock_check_rgb"],
        "@LOCK_FAIL_RGB@": colors["lock_fail_rgb"],
        "@LOCK_DATE_RGBA@": rgba_from_hex(colors["green"]),
        "@LOCK_STATUS_RGBA@": rgba_from_hex(colors["comment"]),
    }
    for token, value in values.items():
        template = template.replace(token, value)
    return f"{GENERATED_HEADER}\n# Active theme: {theme['id']} ({theme['label']})\n\n{template}"


def render_waybar_colors(theme: dict[str, Any]) -> str:
    c = theme["colors"]
    return f"""{CSS_HEADER}
/* Active theme: {theme['id']} ({theme['label']}) */
@define-color background   {c['background']};
@define-color current-line {c['current_line']};
@define-color selection    {c['selection']};
@define-color foreground   {c['foreground']};
@define-color comment      {c['comment']};
@define-color cyan         {c['cyan']};
@define-color green        {c['green']};
@define-color orange       {c['orange']};
@define-color pink         {c['pink']};
@define-color purple       {c['purple']};
@define-color red          {c['red']};
@define-color yellow       {c['yellow']};
@define-color muted        {c['muted']};
@define-color border       {c['border']};
@define-color surface-hover {c['surface_hover']};
@define-color selection-hover {c.get('selection_hover', c['selection'])};
@define-color selection-border {c['selection_border']};
@define-color panel        {c['waybar_panel']};
@define-color gradient-start {c['waybar_gradient_start']};
@define-color gradient-end {c['waybar_gradient_end']};
@define-color active-foreground {c['waybar_active_foreground']};
@define-color urgent-background {c['waybar_urgent_background']};
"""


def render_gtk_theme_css(theme: dict[str, Any]) -> str:
    c = theme["colors"]
    return f"""{CSS_HEADER}
/* Active theme: {theme['id']} ({theme['label']}) */
@define-color bg {c['background']};
@define-color panel {c['panel']};
@define-color surface {c['surface']};
@define-color surface_alt {c['surface_alt']};
@define-color current_line {c['current_line']};
@define-color surface_hover {c['surface_hover']};
@define-color selection {c['selection']};
@define-color selection_hover {c.get('selection_hover', c['selection'])};
@define-color selection_border {c['selection_border']};
@define-color border {c['border']};
@define-color foreground {c['foreground']};
@define-color muted {c['muted']};
@define-color comment {c['comment']};
@define-color red {c['red']};
@define-color orange {c['orange']};
@define-color yellow {c['yellow']};
@define-color green {c['green']};
@define-color cyan {c['cyan']};
@define-color purple {c['purple']};
@define-color pink {c['pink']};
@define-color control_center_background {c['swaync_panel']};
@define-color critical_background {c['swaync_critical_background']};
@define-color launcher_background {c['wofi_window_background']};
"""


def render_kitty_theme(theme: dict[str, Any]) -> str:
    c = theme["colors"]
    kitty = theme.get("kitty", {})
    opacity = kitty.get("background_opacity", "0.80")
    bg = color_hex_no_hash(c["background"])
    fg = color_hex_no_hash(c["foreground"])
    selection = color_hex_no_hash(c["selection"])
    comment = color_hex_no_hash(c["comment"])
    red = color_hex_no_hash(c["red"])
    green = color_hex_no_hash(c["green"])
    yellow = color_hex_no_hash(c["yellow"])
    purple = color_hex_no_hash(c["purple"])
    pink = color_hex_no_hash(c["pink"])
    cyan = color_hex_no_hash(c["cyan"])
    orange = color_hex_no_hash(c["orange"])
    return f"""{GENERATED_HEADER}
# Active theme: {theme['id']} ({theme['label']})
foreground            #{fg}
background            #{bg}
selection_foreground  #ffffff
selection_background  #{selection}

color0  #21222c
color1  #{red}
color2  #{green}
color3  #{yellow}
color4  #{purple}
color5  #{pink}
color6  #{cyan}
color7  #{fg}
color8  #{comment}
color9  #{red}
color10 #{green}
color11 #{yellow}
color12 #{purple}
color13 #{pink}
color14 #{cyan}
color15 #ffffff
color16 #{orange}

cursor            #{fg}
cursor_text_color background
url_color         #{cyan}

active_tab_foreground   #{bg}
active_tab_background   #{fg}
inactive_tab_foreground #{bg}
inactive_tab_background #{comment}

mark1_foreground #{bg}
mark1_background #{red}

background_opacity {opacity}
dynamic_background_opacity yes
"""


def write_generated(theme: dict[str, Any]) -> list[Path]:
    outputs = {
        REPO / "hypr" / "theme.conf": render_hypr_theme(theme),
        REPO / "hypr" / "hyprpaper.conf": render_hyprpaper(theme),
        REPO / "hypr" / "hyprlock.conf": render_hyprlock(theme),
        REPO / "waybar" / "colors.css": render_waybar_colors(theme),
        REPO / "swaync" / "theme.css": render_gtk_theme_css(theme),
        REPO / "wofi" / "theme.css": render_gtk_theme_css(theme),
        REPO / "kitty" / "theme.conf": render_kitty_theme(theme),
        CURRENT_FILE: f"{theme['id']}\n",
    }
    for path, content in outputs.items():
        atomic_write(path, content)
    return sorted(outputs)


def active_config_warnings() -> list[str]:
    checks = [
        (REPO / "hypr", Path.home() / ".config" / "hypr"),
        (REPO / "waybar", Path.home() / ".config" / "waybar"),
        (REPO / "swaync", Path.home() / ".config" / "swaync"),
        (REPO / "wofi", Path.home() / ".config" / "wofi"),
        (REPO / "kitty", Path.home() / ".config" / "kitty"),
    ]
    warnings = []
    for src, dst in checks:
        try:
            if not dst.exists():
                warnings.append(f"{dst} does not exist; cannot verify linkage to {src}")
            elif dst.resolve() != src.resolve():
                warnings.append(f"{dst} is not linked to {src}; reload may not use this worktree")
        except OSError:
            warnings.append(f"could not inspect {dst}")
    return warnings


def reload_waybar() -> None:
    if not command_exists("waybar"):
        print("reload: waybar not installed; skipped")
        return
    proc = run(["pgrep", "-x", "waybar"])
    pids = [int(line) for line in proc.stdout.splitlines() if line.strip().isdigit()]
    if not pids:
        print("reload: waybar not running; skipped")
        return
    for pid in pids:
        os.kill(pid, signal.SIGUSR2)
    print(f"reload: sent SIGUSR2 to waybar ({len(pids)} process(es))")


def reload_swaync() -> None:
    if command_exists("swaync-client"):
        run(["swaync-client", "--reload-css"])
        run(["swaync-client", "--reload-config"])
        print("reload: requested swaync css/config reload")
    else:
        print("reload: swaync-client not installed; skipped")


def reload_hyprland(theme: dict[str, Any]) -> None:
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or not command_exists("hyprctl"):
        print("reload: no Hyprland IPC; skipped hyprctl reload")
        return
    c = theme["colors"]
    result = run(["hyprctl", "reload"])
    if result.returncode == 0:
        print("reload: hyprctl reload ok")
    else:
        print(f"reload: hyprctl reload failed: {result.stderr.strip()}")

    # Re-apply theme tokens through IPC after reload. This keeps live switching
    # visible even when testing from an isolated worktree that is not the active
    # ~/.config/hypr link yet.
    for key, value in [
        ("general:col.active_border", c["hypr_active_border"]),
        ("general:col.inactive_border", c["hypr_inactive_border"]),
    ]:
        result = run(["hyprctl", "keyword", key, value])
        if result.returncode != 0:
            print(f"reload: hyprctl keyword {key} failed: {result.stderr.strip()}")


def reload_hyprpaper(theme: dict[str, Any]) -> None:
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or not command_exists("hyprctl"):
        print("reload: no Hyprland IPC; skipped hyprpaper")
        return
    wallpaper = str(wallpaper_path(theme))
    fit = theme.get("wallpaper_fit", "cover")
    run(["hyprctl", "hyprpaper", "preload", wallpaper])
    targets = [""] + monitor_names(theme)
    ok = 0
    for monitor in targets:
        arg = f"{monitor},{wallpaper},{fit}"
        result = run(["hyprctl", "hyprpaper", "wallpaper", arg])
        if result.returncode == 0:
            ok += 1
    run(["hyprctl", "hyprpaper", "unload", "unused"])
    print(f"reload: hyprpaper wallpaper updates attempted ({ok}/{len(targets)} accepted)")


def reload_components(theme: dict[str, Any]) -> None:
    for warning in active_config_warnings():
        print(f"warning: {warning}", file=sys.stderr)
    reload_hyprpaper(theme)
    reload_hyprland(theme)
    reload_swaync()
    reload_waybar()
    print("reload: kitty/wofi/hyprlock pick up theme on next launch")


def doctor() -> int:
    status = 0
    for warning in active_config_warnings():
        print(f"WARN {warning}")
        status = 1
    for theme_name in list_themes():
        load_theme(theme_name)
        print(f"OK theme {theme_name}")
    current = current_theme()
    if current:
        print(f"OK current theme: {current}")
    else:
        print("WARN no active theme recorded")
        status = 1
    return status


def main() -> int:
    parser = argparse.ArgumentParser(description="Switch Hyprland desktop themes")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list", help="list available themes")
    sub.add_parser("current", help="print active theme")
    sub.add_parser("doctor", help="validate themes and live config linkage")
    apply_parser = sub.add_parser("apply", help="render and apply a theme")
    apply_parser.add_argument("theme", choices=list_themes())
    apply_parser.add_argument("--no-reload", action="store_true", help="render files but do not reload live components")

    args = parser.parse_args()
    if args.command == "list":
        active = current_theme()
        for name in list_themes():
            marker = "*" if name == active else " "
            print(f"{marker} {name}")
        return 0
    if args.command == "current":
        active = current_theme()
        if not active:
            return 1
        print(active)
        return 0
    if args.command == "doctor":
        return doctor()
    if args.command == "apply":
        theme = load_theme(args.theme)
        outputs = write_generated(theme)
        for path in outputs:
            print(f"wrote {path.relative_to(REPO)}")
        if not args.no_reload:
            reload_components(theme)
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
