#!/bin/bash
# .aliases file

################################################################################
# EZA ALIASES
################################################################################
# Mnemonic System:
#   l  -> Long format (-l)
#   a  -> All files, including hidden (-a)
#   t  -› Tree view (-T)
#   h  -› Human-readable file sizes (-h)
#   g  -› Git status (--git)
#   s  -› Sort by... (followed by another letter)
#   o  -› Octal permissions (--octal-permissions)
#
# Examples:
#   'la'  -> List All files
#   'll'  -> Long List
#   'lla' -> Long List All files
#   'lt'  -> List in a Tree view
#   'lts' -> List Tree, sorted by Size
################################################################################
# sudo fix
alias sudo='sudo '

########################################
# Base ls Replacement
########################################
# Your default `ls` command. The foundation for other aliases.
alias ls='eza --icons --group-directories-first --color=auto'

########################################
# Core Listing Aliases
########################################
# Show all files (including hidden) in a simple list.
alias la='ls -a'

# The classic "long list" format.
alias l='ls -lh'
alias ll='ls -lah'

# Long list, but with human-readable file sizes (e.g., 4.2K, 1.3M).
alias lh='ls -lh'

# The most common detailed view: Long list, All files, Human-readable.
alias lla='ls -lah'
alias llh='ls -lah' # Common alternative for the same command

# List only directories, long format, human-readable.
alias lld='ls -lhD'

# lsz — list files by size, human-readable, minimal info
# Usage: lsz -b [path] (largest→smallest) | lsz -s [path] (smallest→largest)
lsz() {
  case "$1" in
  # Standardized 'exa' to 'eza' (maintained fork)
  -l)
    shift
    eza --only-files -lh --no-permissions --no-user --no-time --sort=size --reverse "${@:-.}"
    ;;
  -s)
    shift
    eza --only-files -lh --no-permissions --no-user --no-time --sort=size "${@:-.}"
    ;;
  *) echo "Usage: lsz -l [path] (largest→smallest) | lsz -s [path] (smallest→largest)" ;;
  esac
}

########################################
# Tree Views
########################################
# Standard tree view.
alias lt='ls -T'

# Tree view including hidden files.
alias lta='ls -Ta'

# Tree view with all files using tree command.
alias llt='tree -a'

# Tree view with specified depth.
alias lt1='ls -T --level=1'
alias lt2='ls -T --level=2'
alias lt3='ls -T --level=3'

########################################
# Sorting Aliases (builds on `ll`)
########################################
# Long list, sorted by newest modified date first.
alias lsn='ll --sort=newest'

# Long list, sorted by oldest modified date first.
alias lso='ll --sort=oldest'

# Long list, sorted by file size (largest first).
alias lss='ll --sort=size'

# Long list, sorted by file extension.
alias lse='ll --sort=extension'

########################################
# Special Integrations (builds on `ll`)
########################################
# Long list with Git status.
alias lg='ll --git'

# Long list with Git status for all files.
alias lga='lla --git'

# Long list with file permissions shown in octal format.
alias lo='ll --octal-permissions'

# Long list, octal permissions, and human-readable sizes.
alias loh='lh --octal-permissions'

########################################
# Bash
########################################
alias reload='source ~/.zshrc'

########################################
# Editors
########################################
alias vim='nvim'
alias vi='nvim'
alias v='nvim'

alias emacs='emacsclient -c -a "emacs"'
alias em='emacsclient -t -a ""'

########################################
# Navigation
########################################
# Unalias first to allow functions to take precedence
unalias .. ... .... 2>/dev/null

function .. {
  if [ -z "$1" ]; then cd ..; else cd "../$1"; fi
}
function ... {
  if [ -z "$1" ]; then cd ../..; else cd "../../$1"; fi
}
function .... {
  if [ -z "$1" ]; then cd ../../..; else cd "../../../$1"; fi
}

cp..() { cp -i "$@" ..; }
cp...() { cp -i "$@" ../..; }
cp....() { cp -i "$@" ../../..; }

mv..() { mv -i "$@" ..; }
mv...() { mv -i "$@" ../..; }
mv....() { mv -i "$@" ../../..; }

########################################
# Terminal
########################################
#alias c='clear && colorscript --exec crunchbang-mini'
alias c='clear'

########################################
# Desktop helpers
########################################
wb() {
  case "$1" in
    refresh)
      if ! pgrep -x waybar >/dev/null 2>&1; then
        echo "waybar is not running"
        return 1
      fi
      pkill -SIGUSR2 waybar
      echo "waybar refresh signal sent"
      ;;
    *)
      echo "Usage: wb refresh"
      return 1
      ;;
  esac
}

########################################
# History
########################################
alias h='history | tail -10'
alias hc='history -c'
alias hgrep='history | grep'

########################################
# Misc
########################################
alias fetch='fastfetch'
alias top='btop'
alias ping='ping -c 5'
alias usage='ncdu --color dark'
alias df='df -h'
alias du='du -sh'
alias dud='\du -h -d 1'
alias bigs='\du -ah . | sort -rh | head -20'
alias tmux-reload='tmux source-file ~/.tmux.conf && tmux display-message "Config reloaded ✔"'

########################################
# OpenCode (depreciated)
########################################
alias ask='opencode run --model openrouter/x-ai/grok-4.1-fast'

########################################
# Aliases for pikaur
########################################
# 1. Update and Upgrade System
alias pi='pikaur -Syu'

# 2. Search for a Package
alias pis='pikaur -Ss'

# 3. Install a Package
alias pii='pikaur -S'

# 4. Remove a Package
alias pir='pikaur -R'

# 5. Remove a Package and Unused Dependencies
alias pirn='pikaur -Rns'

# 6. Upgrade Only AUR Packages
alias piu='pikaur -Sua'

# 7. Clean Cache
alias pic='pikaur -Sc'

# 8. Show Orphans
alias pio='pikaur -Qdt'

# 9. Remove All Orphans
alias pior='pikaur -Rns $(pikaur -Qdtq)'

# 10. View Installed Packages
alias piq='pikaur -Q'
alias piqs='pikaur -Qs'

# 11. View AUR Packages Installed
alias pia='pikaur -Qm'

# 12. Get Info on a Specific Package
alias pinfo='pikaur -Qi'

# 13. List Files Installed by a Package
alias pil='pikaur -Ql'

# 14. Clean Unused Dependencies
alias pid='pikaur -R $(pikaur -Qdtq)'

# 15. Download Package without Installing
alias pidown='pikaur -Sw'

# 16. Edit a PKGBUILD Before Installing
alias pie='pikaur --edit'

# 17. Check for Outdated Packages
alias piout='pikaur -Qum'

# 18. Show Package Dependencies
alias pdep='pikaur -Si'

########################################
# Plex Sync
########################################
# Variables for easy maintenance
PLEX_HOST="w0lf@192.168.68.66"
PLEX_BASE="/mnt/media"

rsmovies() {
  rsync -avh --progress "$@" "$PLEX_HOST:$PLEX_BASE/Movies/"
  [ $? -ne 0 ] && echo "🚨 Rsync failed for Movies." >&2
}

rstv() {
  rsync -avh --progress "$@" "$PLEX_HOST:$PLEX_BASE/TV/"
  [ $? -ne 0 ] && echo "🚨 Rsync failed for TV." >&2
}

rsmusic() {
  rsync -avh --progress "$@" "$PLEX_HOST:$PLEX_BASE/Music/"
  [ $? -ne 0 ] && echo "🚨 Rsync failed for Music." >&2
}

########################################
# Apple Superdrive
########################################

spititout() {
  drive=$(lsblk -ndo NAME,TYPE | awk '$2 == "rom" {print "/dev/"$1; exit}')
  if [ -n "$drive" ]; then
    echo "⏏️Ejecting $drive… 💿"
    eject "$drive"
  else
    echo "No optical drive found." >&2
  fi
}

########################################
# Safety
########################################
alias mv='mv -i'     # prompt before overwrite
alias cp='cp -i'     # prompt before overwrite
alias rm='rm -i'     # prompt before delete
alias rmd='rm -r -I' # prompt once before recursive delete

########################################
# Clear File
########################################
alias clf='truncate -s 0'

########################################
# Config Shortcuts
########################################
alias hyprcon='vim ~/.config/hypr/hyprland.conf'
alias wbcon='vim ~/.config/waybar/config'
alias zshcon='vim ~/.zshrc'
alias alcon='vim ~/.aliases'
alias kitcon='vim ~/.config/kitty/kitty.conf'
alias tmcon='vim ~/.config/tmux/tmux.conf'
alias nvcon='vim ~/.config/nvim'

########################################
# Claude Accounts
########################################
alias claude-personal="CLAUDE_CONFIG_DIR=~/.claude-personal claude"
alias claude-work="CLAUDE_CONFIG_DIR=~/.claude-work claude"

